{
  "name": "@red-cup-engineering/flatfile-engineering-services-section",
  "version": "0.3.0",
  "type": "module",
  "description": "Plain flatfile: whole-file atomic text write (temp + fsync + rename), synchronous UTF-8 whole-file text read (readFlatfileText), a binarity sniff over a regular file's leading bytes, and a plain classifier for the file -> regular-file -> flatfile spine. A flatfile is a NUL-free regular file -- the base byte-touch every text codec composes.",
  "keywords": [
    "flatfile",
    "computer-data",
    "561-group"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/flatfile-engineering-services-section.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/flatfile.mjs",
    "./read-flatfile-text": "./scripts/read-flatfile-text.mjs",
    "./package.json": "./package.json",
    "./file-receipt-store": "./src/file-receipt-store.mjs"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "test",
    "specifications",
    "docs/API.md",
    "examples/quickstart.test.mjs"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:consumer": "node --test examples/quickstart.test.mjs"
  },
  "license": "MIT",
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  },
  "receivingTests": [
    "test/flatfile.test.mjs",
    "test/publication.test.mjs",
    "test/receipt-store-lock.test.mjs",
    "test/receipt-store-claims.test.mjs"
  ]
}

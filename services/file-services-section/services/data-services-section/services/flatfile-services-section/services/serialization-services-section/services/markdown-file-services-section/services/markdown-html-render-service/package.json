{
  "name": "@red-cup-engineering/markdown-html-render-service",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Renders a parsed Markdown document to HTML. Use when producing an HTML view of Markdown already parsed by the document codec.",
  "exports": {
    ".": {
      "types": "./dist/html.d.mts",
      "import": "./dist/html.mjs"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@red-cup-engineering/markdown-block-html-render-service": "0.1.1",
    "@red-cup-engineering/markdown-inline-html-render-service": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}

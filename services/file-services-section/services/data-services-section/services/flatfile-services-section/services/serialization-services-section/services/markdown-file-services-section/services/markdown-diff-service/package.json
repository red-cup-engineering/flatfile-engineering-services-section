{
  "name": "@red-cup-engineering/markdown-diff-service",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Computes a structural diff between two Markdown documents. Use when comparing versions of Markdown content rather than line-diffing text.",
  "exports": {
    ".": {
      "types": "./dist/diff.d.mts",
      "import": "./dist/diff.mjs"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@red-cup-engineering/json-file-codec-service": "0.1.3",
    "@red-cup-engineering/markdown-document-codec-service": "0.1.2",
    "@red-cup-engineering/markdown-workbench-service": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}

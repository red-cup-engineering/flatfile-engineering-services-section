{
  "name": "@red-cup-engineering/markdown-edit-service",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Applies structured edit operations to a Markdown document model. Use when programmatically changing Markdown rather than hand-editing text.",
  "exports": {
    ".": {
      "types": "./dist/edit.d.mts",
      "import": "./dist/edit.mjs"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@red-cup-engineering/json-file-codec-service": "0.1.3",
    "@red-cup-engineering/toml-file-codec-service": "0.1.1",
    "@red-cup-engineering/markdown-document-codec-service": "0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}

    "./dated-state": "./src/dated-state-writing.mjs",
    "./write-dated-state": "./scripts/write-dated-state.mjs",
    "./read-dated-state": "./scripts/read-dated-state.mjs",
    "./publish-staged-directory-at-absent-path": "./scripts/publish-staged-directory-at-absent-path.mjs",
    "./zip-archive": "./src/zip-archive.mjs",
    "./declared-directory-root": "./src/declared-directory-root.mjs"

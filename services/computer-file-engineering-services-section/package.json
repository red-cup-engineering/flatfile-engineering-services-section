    "@red-cup-engineering/jsonl-services-section": "0.1.0",
    "@red-cup-engineering/signcell": "0.1.0"
  },
  "x-capability-recovery": [
    {
      "capability": "bounded-markdown-read",
      "owner": "@red-cup-engineering/markdown-engineering-services-section"

    "./write-file": "./scripts/write-file.mjs",
    "./infomaterial": "./src/infomaterial.mjs",
    "./read-text-file": "./scripts/read-text-file.mjs",
    "./require-text-file-read": "./src/require-text-file-read.mjs",
    "./apply-text-file-content-edits": "./scripts/apply-text-file-content-edits.mjs",
    "./admit-text-file-creation-projection": "./scripts/admit-text-file-creation-projection.mjs",
    "./write-text-file": "./scripts/write-text-file.mjs",
    "./admit-text-file-creation-projection-set": "./scripts/admit-text-file-creation-projection-set.mjs",
    "./file-content-witness": "./src/file-content-witness.mjs",
    "./dangling-symlinks": "./src/observe-dangling-symlinks.mjs",

  },
  "files": [
    "scripts",
    "src"
  ],
  "scripts": {
    "check": "node --check scripts/*.mjs src/*.mjs",
    "test": "node --experimental-vm-modules --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/computer-content-address-engineering-services-section": "0.2.0",

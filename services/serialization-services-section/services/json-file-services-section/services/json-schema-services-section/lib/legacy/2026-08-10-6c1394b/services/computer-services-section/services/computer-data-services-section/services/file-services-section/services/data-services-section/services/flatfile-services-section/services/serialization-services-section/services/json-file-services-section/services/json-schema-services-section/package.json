{
  "name": "@red-cup-engineering/json-schema-services-section",
  "version": "0.1.4",
  "private": false,
  "type": "module",
  "description": "Canonical Red Cup JSON Schema semantics and path-addressed reading, writing, searching, validation, resolution, projection, and census services.",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./read-a-schema": "./scripts/read-a-schema.mjs",
    "./write-a-schema": "./services/writing-a-schema/src/write-a-schema.js",
    "./search-path-for-schema": "./services/search-path-for-schema/src/search-path-for-schema.mjs",
    "./census": "./dist/census.mjs"
  },
  "bin": {
    "json-schema-census": "./scripts/json-schema-census.mjs",
    "read-a-schema": "./scripts/read-a-schema.mjs",
    "write-a-schema": "./services/writing-a-schema/src/write-a-schema.js",
    "search-path-for-schema": "./services/search-path-for-schema/scripts/search-path-for-schema.mjs"
  },
  "files": [
    "dist/",
    "scripts/json-schema-census.mjs",
    "scripts/read-a-schema.mjs",
    "services/search-path-for-schema/scripts/search-path-for-schema.mjs",
    "services/search-path-for-schema/src/search-path-for-schema.mjs",
    "services/writing-a-schema/src/write-a-schema.js"
  ],
  "dependencies": {
    "@red-cup-engineering/json-file-codec-service": "workspace:*",
    "@red-cup-engineering/ni-services-section": "workspace:*",
    "@red-cup-engineering/semantic-content-identify-service": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "node --check src/route-a-service.js && node --check scripts/json-schema-census.mjs && node --check scripts/read-a-schema.mjs && node --check services/writing-a-schema/src/write-a-schema.js && node --check services/search-path-for-schema/src/search-path-for-schema.mjs && node --check services/search-path-for-schema/scripts/search-path-for-schema.mjs",
    "test": "node --test test/*.test.mjs services/search-path-for-schema/test/*.test.mjs",
    "census": "node scripts/json-schema-census.mjs --root /home/emsenn/bare-cedar-fog --out /home/emsenn/bare-cedar-fog/services/red-cup-engineering/services/software-services-section/services/data-services-section/services/file-services-section/services/data-services-section/services/flatfile-services-section/services/serialization-services-section/services/json-file-services-section/services/json-schema-services-section/data/recovery/json-schema-census.json",
    "census:verify": "node scripts/json-schema-census.mjs --root /home/emsenn/bare-cedar-fog --out /home/emsenn/bare-cedar-fog/services/red-cup-engineering/services/software-services-section/services/data-services-section/services/file-services-section/services/data-services-section/services/flatfile-services-section/services/serialization-services-section/services/json-file-services-section/services/json-schema-services-section/data/recovery/json-schema-census.json --verify",
    "verify": "npm run build && npm run check && npm test"
  }
}

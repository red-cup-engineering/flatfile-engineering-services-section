{
  "name": "@red-cup-engineering/html-document-render-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Renders a carrier node tree with resolved CSS into a complete HTML document string. Use when producing styled HTML from data, not when parsing or validating HTML files.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/css-services-section": "workspace:*",
    "@red-cup-engineering/json-services-section": "workspace:*",
    "@red-cup-engineering/computer-data-engineering-services-section": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "@red-cup-engineering/exact-number-data-service": "workspace:*"
  },
  "sideEffects": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/schema/computer-data/actor",
  "title": "Actor",
  "description": "The single Actor carrier. Actor identity is an EAVT constitution whose address is actor:<RFC6920 digest>; all office, principal, credential, resource, session, and application relations remain separate EAVT rows addressed to that Actor.",
  "oneOf": [
    {
      "$ref": "#/$defs/genesis"
    },
    {
      "$ref": "#/$defs/record"
    }
  ],
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^actor:[A-Za-z0-9_-]+$"
    },
    "row": {
      "type": "object",
      "required": [
        "e",
        "a",
        "v",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "e": {
          "type": [
            "string",
            "null"
          ]
        },
        "a": {
          "type": "string"
        },
        "v": {},
        "t": {}
      }
    },
    "genesis": {
      "allOf": [
        {
          "$ref": "#/$defs/row"
        },
        {
          "properties": {
            "e": {
              "$ref": "#/$defs/address"
            },
            "a": {
              "const": "constituted"
            },
            "v": {
              "type": "object"
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "address",
        "genesisRow",
        "attributes",
        "t",
        "names",
        "supersedes"
      ],
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "genesisRow": {
          "$ref": "#/$defs/genesis"
        },
        "attributes": {
          "type": "object"
        },
        "t": {},
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}

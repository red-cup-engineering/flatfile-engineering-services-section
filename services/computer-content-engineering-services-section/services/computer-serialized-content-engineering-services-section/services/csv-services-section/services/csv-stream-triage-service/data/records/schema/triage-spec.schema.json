{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "triage spec",
  "description": "What to stream, which rows to keep, and which columns to retain. A spec for a particular source (its URL and column values) is a data record owned by whoever uses the source, not part of this package.",
  "type": "object",
  "required": ["kind", "version", "id", "source", "filters", "keep"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "triage-spec" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": { "url": { "type": "string", "pattern": "^https://" }, "note": { "type": "string" } }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["column"],
        "minProperties": 2,
        "maxProperties": 2,
        "additionalProperties": false,
        "properties": {
          "column": { "type": "string", "minLength": 1 },
          "equals": { "type": "string" },
          "in": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "notEmpty": { "const": true }
        }
      }
    },
    "deadline": {
      "type": "object",
      "required": ["column", "mustBeAfterRun"],
      "additionalProperties": false,
      "properties": {
        "column": { "type": "string", "minLength": 1, "description": "ISO 8601 with offset. Empty or unparseable values are counted and dropped." },
        "mustBeAfterRun": { "const": true }
      }
    },
    "keep": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "limit": { "type": "integer", "minimum": 1 }
  }
}

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>$if(title-prefix)$$title-prefix$ – $endif$$if(title)$$title$$else$Relationing Research Program$endif$</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    $if(author-meta)$
    <meta name="author" content="$author-meta$" />
    $endif$
    $if(date-meta)$
    <meta name="date" content="$date-meta$" />
    $endif$
    $if(keywords)$
    <meta name="keywords" content="$for(keywords)$$keywords$$sep$, $endfor$" />
    $endif$
    $if(description)$
    <meta name="description" content="$description$" />
    $endif$
    $if(css)$
    $for(css)$
    <link rel="stylesheet" href="$css$" />
    $endfor$
    $endif$
  </head>
  <body>
    <header class="rrpr-header">
      <div class="rrpr-meta">
        <div class="rrpr-project">Relationing Research Program Repository</div>
        $if(date)$<div class="rrpr-date">$date$</div>$endif$
      </div>
      <h1>$if(title)$$title$$else$Untitled Document$endif$</h1>
      $if(author)$
      <div class="rrpr-authors">
        $for(author)$<span class="rrpr-author">$author$</span>$sep$, $endfor$
      </div>
      $endif$
    </header>

    <main id="content">
      $body$
    </main>

    <footer class="rrpr-footer">
      <p>Generated via rrpr publish — deterministic CMS tooling for the Relationing Research Program.</p>
      <p>$if(commit)$Commit: $commit$$endif$$if(branch)$ · Branch: $branch$$endif$</p>
    </footer>
  </body>
</html>

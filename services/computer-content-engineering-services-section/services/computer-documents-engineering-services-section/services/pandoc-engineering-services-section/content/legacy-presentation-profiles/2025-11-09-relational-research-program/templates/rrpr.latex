\documentclass[11pt]{article}
\usepackage{fontspec}
\usepackage{geometry}
\usepackage{hyperref}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{enumitem}
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\renewcommand{\mathbf}[1]{\textbf{#1}}

\setmainfont{TeX Gyre Schola}
\geometry{margin=1in}
\setlength{\parskip}{0.75em}
\setlength{\parindent}{0pt}
\titlespacing*{\section}{0pt}{1.5ex}{0.5ex}
\titlespacing*{\subsection}{0pt}{1.25ex}{0.25ex}

\hypersetup{
  colorlinks=true,
  linkcolor=black,
  urlcolor=blue,
  pdftitle={$if(title)$$title$$endif$},
  pdfauthor={$for(author)$$author$$sep$, $endfor$}
}

\begin{document}

\begin{center}
  {\LARGE $if(title)$$title$$else$Relationing Research Program$endif$} \\
  \vspace{0.5em}
  {\large Relationing Research Program Repository} \\
  $if(author)$
    \vspace{0.5em}
    $for(author)$
      $author$ $sep$ \\ 
    $endfor$
  $endif$
  $if(date)$
    \vspace{0.5em}
    {\small $date$}
  $endif$
\end{center}

\vspace{1em}
\onehalfspacing

$body$

\end{document}

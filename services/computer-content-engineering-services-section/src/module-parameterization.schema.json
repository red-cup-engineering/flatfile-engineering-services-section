{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:computer-content:module-parameterization:v1",
  "$defs": {
    "dataRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "record",
        "sha256"
      ],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^@[^/]+/[^/]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "record": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pointer": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "instancePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instancePointer"
      ],
      "properties": {
        "instancePointer": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 2048
        }
      }
    },
    "parameterBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/dataRef"
        },
        {
          "$ref": "#/$defs/instancePointer"
        }
      ]
    },
    "bindings": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": {
        "pattern": "^(?!__proto__$|constructor$|prototype$)[A-Za-z][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameterBinding"
      }
    },
    "directSource": {
      "type": "object",
      "required": [
        "module",
        "export"
      ],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^@[^/]+/[^/]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "configuration": {
          "type": "object"
        }
      },
      "not": {
        "required": [
          "dataRef"
        ]
      }
    },
    "referencedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataRef",
        "parameters"
      ],
      "properties": {
        "dataRef": {
          "$ref": "#/$defs/dataRef"
        },
        "parameters": {
          "$ref": "#/$defs/bindings"
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "module",
        "export",
        "parameters",
        "configuration",
        "parameterSchemas"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "type": {
          "const": "ModuleParameterization"
        },
        "version": {
          "const": 1
        },
        "module": {
          "type": "string",
          "pattern": "^@red-cup-engineering/[^/]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "parameters": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!__proto__$|constructor$|prototype$)[A-Za-z][A-Za-z0-9._-]*$"
          }
        },
        "parameterSchemas": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": {
            "$ref": "#/$defs/modelRef"
          },
          "propertyNames": {
            "pattern": "^(?!__proto__$|constructor$|prototype$)[A-Za-z][A-Za-z0-9._-]*$"
          }
        },
        "configuration": {
          "type": "object"
        }
      }
    },
    "modelRef": {
      "allOf": [
        {
          "$ref": "#/$defs/dataRef"
        },
        {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "pattern": "^@red-cup-engineering/[^/]+(?:/[A-Za-z0-9._-]+)*$"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/directSource"
    },
    {
      "$ref": "#/$defs/referencedSource"
    }
  ]
}

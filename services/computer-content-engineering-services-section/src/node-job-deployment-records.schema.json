{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:computer-content:node-job-deployment-records:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "law",
    "deploymentRecords"
  ],
  "properties": {
    "law": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "deploymentRecords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deployment",
          "host",
          "jobConfiguration",
          "scope"
        ],
        "properties": {
          "deployment": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 128
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "jobConfiguration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runtimeRoot",
              "jobsDirectory",
              "stateRoot",
              "unitPrefix",
              "artifact"
            ],
            "properties": {
              "runtimeRoot": {
                "type": "string",
                "pattern": "^(?:\\{release\\}|/[^\\u0000]*)$"
              },
              "artifact": {
                "type": "string",
                "pattern": "^(?:\\{release\\}|/[^\\u0000]*)$"
              },
              "jobsDirectory": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000]+$"
              },
              "stateRoot": {
                "type": "string",
                "pattern": "^/[^\\u0000]+$"
              },
              "unitPrefix": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            }
          },
          "scope": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}

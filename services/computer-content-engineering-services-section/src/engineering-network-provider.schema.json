{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:computer-content:engineering-network-provider-list:v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 32,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "prefix",
      "description",
      "module",
      "export"
    ],
    "properties": {
      "prefix": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "module": {
        "type": "string",
        "pattern": "^@red-cup-engineering/[^/]+(?:/[A-Za-z0-9._-]+)*$"
      },
      "export": {
        "type": "string",
        "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
      },
      "configuration": {
        "type": "object"
      },
      "variables": {
        "type": "object",
        "maxProperties": 20,
        "propertyNames": {
          "pattern": "^(?!__proto__$|constructor$|prototype$)[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "properties": {
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "const": "environment"
              }
            }
          }
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "name"
          ],
          "properties": {
            "source": {
              "enum": [
                "config",
                "environment"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      },
      "only": {
        "type": "array",
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "inferenceCallProvider": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    }
  }
}

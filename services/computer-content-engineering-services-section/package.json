{
  "name": "@red-cup-engineering/computer-content-engineering-services-section",
  "version": "0.1.0",
  "type": "module",
  "description": "Content: data carriers with locator-independent identity and custody, their typed-resource classification and catalog, and descriptions.",
  "dependencies": {
    "@red-cup-engineering/cbor-services-section": "workspace:*",
    "@red-cup-engineering/computer-content-address-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/cryptographic-computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/json-schema-services-section": "workspace:*",
    "@red-cup-engineering/json-services-section": "workspace:*",
    "@red-cup-engineering/uri-services-section": "workspace:*"
  },
  "exports": {
    "./description": "./src/description.mjs",
    "./typed-resource-classification": "./src/typed-resource-classification.mjs",
    "./catalog": "./src/catalog.mjs",
    "./recognition": "./src/recognition.mjs",
    "./language-cone": "./src/language-cone.mjs",
    "./resource-term": "./src/resource-term.mjs",
    "./receipt-sen": "./src/receipt-sen.mjs",
    "./signed-export-receipt": "./src/signed-export-receipt.mjs",
    "./signed-content-claim": "./src/signed-content-claim.mjs",
    "./json-projector": "./src/json-projector.mjs",
    "./text-projector": "./src/text-projector.mjs",
    "./jupyter/codec": "./src/jupyter/codec.mjs",
    "./jupyter/schema": "./src/jupyter/schema.mjs",
    "./dataset-store": "./src/dataset-store.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "x-capability-recovery": [
    {
      "capability": "typed-resource-classification",
      "source": "@red-cup-engineering/typed-resource-catalog",
      "owner": "./src/typed-resource-classification.mjs"
    },
    {
      "capability": "canonical-relational-dataset-custody",
      "source": "content-addressed-dataset-store-service",
      "owner": "./src/dataset-store.mjs",
      "provenance": "./provenance/dataset-custody-recovery.json"
    },
    {
      "capability": "semantic-content-identity",
      "source": "@red-cup-engineering/computer-content-address-engineering-services-section/semantic-content-identity",
      "owner": "@red-cup-engineering/computer-content-address-engineering-services-section"
    },
    {
      "capability": "immutable-network-byte-custody",
      "source": "@red-cup-engineering/immutable-content-custody-service",
      "owner": "@red-cup-engineering/immutable-content-custody-service"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/computer/evidence.schema.json",
  "title": "Evidence",
  "description": "An observed or sourced carrier. Evidence supports a claim or relation witness; it never silently establishes truth or authority.",
  "type": "object",
  "required": [
    "kind",
    "source",
    "observedAt",
    "content",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "evidence"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "object"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "x-codegen": {
    "exportName": "evidenceSchema",
    "typeName": "Evidence",
    "runtimeName": "evidenceType"
  }
}

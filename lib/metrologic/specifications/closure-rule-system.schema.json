{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:561:metrologic:closure-rule-system:v1",
  "title": "Finite positive-threshold FOUR closure system",
  "description": "Executable, purely additive finite declaration. The actual interpreter is the existing metrologic closure-rule-system carrier; JSON Schema checks shape only, not cross-cell membership, rule-name identity, provenance or the mathematical theorem.",
  "type": "object",
  "required": [
    "kind",
    "cells",
    "rules"
  ],
  "properties": {
    "kind": {
      "const": "closureRule.system.carrier"
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "knowledgeReading": {
      "type": "string",
      "enum": [
        "absurd",
        "potential",
        "active",
        "stable"
      ],
      "description": "Generated FOUR, source-owned names: none, for only, against only, both."
    },
    "antecedent": {
      "type": "object",
      "required": [
        "cell",
        "atLeast"
      ],
      "properties": {
        "cell": {
          "type": "string",
          "minLength": 1
        },
        "atLeast": {
          "$ref": "#/$defs/knowledgeReading"
        }
      },
      "additionalProperties": false
    },
    "consequent": {
      "type": "object",
      "required": [
        "cell",
        "reading"
      ],
      "properties": {
        "cell": {
          "type": "string",
          "minLength": 1
        },
        "reading": {
          "$ref": "#/$defs/knowledgeReading"
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "antecedent",
        "consequent"
      ],
      "properties": {
        "kind": {
          "const": "closureRule.rule.carrier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "antecedent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/antecedent"
          }
        },
        "consequent": {
          "$ref": "#/$defs/consequent"
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/computer/claim.schema.json",
  "title": "Claim",
  "description": "A proposition with provenance, held separate from evidence, truth valuation, authority, and effect.",
  "type": "object",
  "required": [
    "kind",
    "subject",
    "predicate",
    "object",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "claim"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object": {},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "x-codegen": {
    "exportName": "claimSchema",
    "typeName": "Claim",
    "runtimeName": "claimType"
  }
}

    },
    "./topology/accountable-attention": {
      "types": "./dist/topology/accountable-attention.d.mts",
      "import": "./dist/topology/accountable-attention.mjs"
    },
    "./topology/article": {
      "types": "./dist/topology/article.d.mts",

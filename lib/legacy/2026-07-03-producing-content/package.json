    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/communicating": "0.0.0",
    "@emsenn/communicating-in-english": "0.0.0",
    "@emsenn/relating": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}

{
  "name": "@emsenn/producing-content",
  "version": "0.0.1",
  "type": "module",
  "description": "Producing content: the content domain (@emsenn/content, the WHAT) organized through @emsenn/organizing into cultivated, witnessed, distributable content. The package root is the fused producing-content surface; facet subpaths expose farm and mill modules while the category tree is being cut.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "content-farm": "./dist/scripts/farm.mjs",
    "content-demand-pull": "./dist/scripts/demand-pull.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "farm": "pnpm run build && node dist/scripts/farm.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./content-farm": {
      "types": "./dist/content-farm/index.d.mts",
      "import": "./dist/content-farm/index.mjs"
    },
    "./content-mill": {
      "types": "./dist/content-mill/index.d.mts",
      "import": "./dist/content-mill/index.mjs"
    },
    "./cable": {
      "types": "./dist/cable/index.d.mts",
      "import": "./dist/cable/index.mjs"
    },
    "./codecs": {
      "types": "./dist/codecs/index.d.mts",
      "import": "./dist/codecs/index.mjs"
    },
    "./codecs/feed": {
      "types": "./dist/codecs/feed.d.mts",
      "import": "./dist/codecs/feed.mjs"
    },
    "./codecs/frontmatter": {
      "types": "./dist/codecs/frontmatter.d.mts",
      "import": "./dist/codecs/frontmatter.mjs"
    },
    "./codecs/jsonld": {
      "types": "./dist/codecs/jsonld.d.mts",
      "import": "./dist/codecs/jsonld.mjs"
    },
    "./codecs/microformats": {
      "types": "./dist/codecs/microformats.d.mts",
      "import": "./dist/codecs/microformats.mjs"
    },
    "./codecs/ninjs": {
      "types": "./dist/codecs/ninjs.d.mts",
      "import": "./dist/codecs/ninjs.mjs"
    },
    "./codecs/references": {
      "types": "./dist/codecs/references.d.mts",
      "import": "./dist/codecs/references.mjs"
    },
    "./codecs/search-console": {
      "types": "./dist/codecs/search-console.d.mts",
      "import": "./dist/codecs/search-console.mjs"
    },
    "./image": {
      "types": "./dist/image/index.d.mts",
      "import": "./dist/image/index.mjs"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.mts",
      "import": "./dist/markdown/index.mjs"
    },
    "./propaganda": {

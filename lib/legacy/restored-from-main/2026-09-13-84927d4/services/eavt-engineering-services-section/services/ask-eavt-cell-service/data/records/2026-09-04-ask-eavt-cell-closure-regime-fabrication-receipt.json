                "kind": "law",
                "authority": "561 Group org layering, EAVT custody",
                "revision": "2026-08-30",
                "locator": ".claude/rules/org-layering.md",
                "applicability": "Applies to every read of an eavt trace: asserted, saturated, and settled are separate derived passes, never one lumped fold.",

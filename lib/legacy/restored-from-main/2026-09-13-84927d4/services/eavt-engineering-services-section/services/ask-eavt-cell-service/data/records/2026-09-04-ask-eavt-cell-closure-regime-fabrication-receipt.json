        "projections": [
            {
                "type": "ArtifactFabricationProjection",
                "version": 1,
                "id": "jsnode-operation-package",
                "target": "@red-cup-engineering/jsnode-operation-package-specification-admission-service",
                "configuration": {
                    "type": "JsnodeOperationPackageSpecificationCandidate",
                    "version": 1,
                    "packageName": "@red-cup-engineering/ask-eavt-cell-service",
                    "packageVersion": "0.3.0",
                    "license": "MIT",
                    "operation": {
                        "type": "JavascriptNodeOperationSource",
                        "path": "scripts/ask-eavt-cell.mjs",
                        "text": "#!/usr/bin/env node\nimport { resolveProofTree, section, stratify } from \"@red-cup-engineering/eavt\";\n\n/**\n * Answers one cell question over an eavt row array with the entity's asserted and saturated counts, its settled section, its proof tree, and the closure/regime of the answer's fold.\n * @param {object} request A record with rows, an entity, and an optional attribute.\n * @returns {object} An EavtCellAnswer record.\n * @throws {TypeError} When entity is not a nonempty string or rows is not an array.\n */\nexport function askEavtCell(request) {\n  if (typeof request?.entity !== \"string\" || request.entity.length === 0 || !Array.isArray(request?.rows)) {\n    throw new TypeError(\"entity and rows are required\");\n  }\n  const attribute = typeof request.attribute === \"string\" ? request.attribute : null;\n  const strata = stratify(request.entity, request.rows, { converse: {} });\n  const settled = section(strata.settled);\n  const keep = (cells) => cells.filter((cell) => attribute === null || cell.predicate === attribute).map((cell) => ({ predicate: cell.predicate, object: cell.object }));\n  const answer = { affirmed: keep(settled.affirmed), denied: keep(settled.denied), contradicted: keep(settled.contradicted) };\n  return {\n    type: \"EavtCellAnswer\",\n    entity: request.entity,\n    attribute,\n    asserted: strata.asserted.filter((row) => attribute === null || row.a === attribute).length,\n    saturated: strata.saturated.filter((row) => attribute === null || row.a === attribute).length,\n    settled: answer,\n    contested: answer.contradicted.length > 0,\n    proofTree: resolveProofTree({ rows: request.rows, root: request.entity }),\n    closure: strata.closure,\n    regime: strata.closure.regime,\n  };\n}\n\nif (import.meta.main) {\n  if (process.argv.includes(\"--help\")) {\n    process.stdout.write(\"askEavtCell \u2014 Answers one cell question over an eavt row array with the entity's asserted and saturated counts, its settled section, its proof tree, and the closure/regime of the answer's fold.\\n\");\n  } else {\n    let text = \"\";\n    for await (const chunk of process.stdin) text += chunk;\n    for (const line of text.split(\"\\n\")) {\n      if (line.length > 0) process.stdout.write(`${JSON.stringify(askEavtCell(JSON.parse(line)))}\\n`);\n    }\n  }\n}\n"
                    },
                    "tests": [
                        {
                            "type": "JavascriptNodeOperationTestSource",
                            "path": "test/ask-eavt-cell.test.mjs",
                            "text": "import assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { askEavtCell } from \"../scripts/ask-eavt-cell.mjs\";\ntest(\"answers one affirmed cell\", () => {\n  const answer = askEavtCell({ rows: [{ e: \"x\", a: \"is\", v: \"y\", t: 1 }], entity: \"x\", attribute: \"is\" });\n  assert.deepEqual(answer.settled.affirmed, [{ predicate: \"is\", object: \"y\" }]);\n  assert.equal(answer.asserted, 1);\n  assert.equal(answer.contested, false);\n});\ntest(\"flags a contested cell through a converse declaration\", () => {\n  const rows = [{ e: \"is\", a: \"has-converse\", v: \"is-not\", t: 0 }, { e: \"x\", a: \"is\", v: \"y\", t: 1 }, { e: \"x\", a: \"is-not\", v: \"y\", t: 2 }];\n  const answer = askEavtCell({ rows, entity: \"x\" });\n  assert.equal(answer.contested, true);\n  assert.deepEqual(answer.settled.contradicted, [{ predicate: \"is\", object: \"y\" }]);\n});\ntest(\"carries the proof tree resolved from the entity\", () => {\n  const answer = askEavtCell({ rows: [{ e: \"x\", a: \"is\", v: \"y\", t: 1 }], entity: \"x\" });\n  assert.equal(answer.proofTree.root, \"x\");\n  assert.deepEqual(answer.proofTree.missing, []);\n  assert.deepEqual(askEavtCell({ rows: [], entity: \"zzz\" }).proofTree.missing, [\"zzz\"]);\n});\ntest(\"carries closure and a top-level regime equal to closure.regime\", () => {\n  const answer = askEavtCell({ rows: [{ e: \"x\", a: \"is\", v: \"y\", t: 1 }], entity: \"x\" });\n  assert.deepEqual(answer.closure, { saturation: 1, transfer: 1, kappa: 1, regime: \"strict\" });\n  assert.equal(answer.regime, \"strict\");\n  assert.equal(answer.regime, answer.closure.regime);\n});\ntest(\"refuses a missing entity\", () => assert.throws(() => askEavtCell({ rows: [] }), /entity and rows are required/u));\n"
                        }
                    ],
                    "examples": [
                        {
                            "type": "JavascriptNodeOperationExample",
                            "name": "answers one affirmed cell",
                            "input": {
                                "rows": [
                                    {
                                        "e": "x",
                                        "a": "is",
                                        "v": "y",
                                        "t": 1
                                    }
                                ],
                                "entity": "x",
                                "attribute": "is"
                            },
                            "output": {
                                "type": "EavtCellAnswer",
                                "entity": "x",
                                "attribute": "is",
                                "asserted": 1,
                                "saturated": 1,
                                "settled": {
                                    "affirmed": [
                                        {
                                            "predicate": "is",
                                            "object": "y"
                                        }
                                    ],
                                    "denied": [],
                                    "contradicted": []
                                },
                                "contested": false,
                                "proofTree": {
                                    "root": "x",
                                    "nodes": {
                                        "x": {
                                            "e": "x",
                                            "a": "is",
                                            "v": "y",
                                            "t": 1
                                        }
                                    },
                                    "edges": [],
                                    "missing": [],
                                    "cycles": [],
                                    "depth": 0
                                },
                                "closure": {
                                    "saturation": 1,
                                    "transfer": 1,
                                    "kappa": 1,
                                    "regime": "strict"
                                },
                                "regime": "strict"
                            }
                        }
                    ],

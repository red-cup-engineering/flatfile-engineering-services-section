{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-exchange-record.schema.json",
  "title": "EnergyExchangeRecord",
  "description": "One energy exchange between two parties over a period: a two-witness record of energy delivered, the primitive the witnessed-kilowatt-hour unit of account is minted from. Settled only when two witnesses of different kinds agree within a declared tolerance; unknown is never zero (the Cistern reconciliation discipline).",
  "type": "object",
  "required": ["id", "kind", "period", "commodity", "quantity", "from", "to", "place", "witnesses", "settlement"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "The RFC 6920 sha-256 ni: URI of the canonical JSON (RFC 8785) of this record with settlement computed and id itself omitted from the hashed form.",
      "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "kind": { "const": "energy-exchange" },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "commodity": {
      "enum": ["KWH", "PROPANE_GAL", "DIESEL_GAL", "CORD_WOOD"]
    },
    "quantity": {
      "type": "string",
      "description": "A decimal amount in the declared commodity's unit. Never a float: exact decimal digits only.",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "from": { "$ref": "#/$defs/party" },
    "to": { "$ref": "#/$defs/party" },
    "place": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "utilityId": { "type": "string" }
      }
    },
    "witnesses": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/witness" }
    },
    "settlement": { "$ref": "#/$defs/settlement" },
    "price": {
      "type": "object",
      "required": ["amount", "commodity", "perUnit"],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "string",
          "description": "A decimal amount. Never a float: exact decimal digits only.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "commodity": { "enum": ["USD", "USDC", "WIT"] },
        "perUnit": {
          "type": "boolean",
          "description": "True when amount is the price per one unit of the exchange's commodity; false when amount is the total price for the whole exchange."
        }
      }
    },
    "tariff": {
      "$ref": "energy-tariff.schema.json"
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id", "role"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "A URN or DID naming the party.",
          "pattern": "^(urn:|did:)"
        },
        "role": {
          "enum": ["producer", "consumer", "grid", "assistance-grantor", "pool"]
        }
      }
    },
    "witness": {
      "type": "object",
      "required": ["kind", "value", "source", "asOf"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["meter", "counterparty-acknowledgment", "utility-statement", "bank-row", "assistance-award"]
        },
        "value": {
          "type": "string",
          "description": "A decimal amount in the record's commodity unit, as this witness reports it. Never a float: exact decimal digits only.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "source": {
          "type": "string",
          "description": "A URL or a record id naming where this witness's value was read.",
          "minLength": 1
        },
        "asOf": { "type": "string", "format": "date-time" }
      }
    },
    "settlement": {
      "type": "object",
      "required": ["status", "mismatch", "settledAt"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["posted", "mismatch", "settled"] },
        "mismatch": {
          "type": ["string", "null"],
          "description": "The decimal difference between two disagreeing witnesses of different kinds, or null when there is no such pair.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "settledAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}

{
  "name": "@red-cup-engineering/relation-model-notation-typing",
  "version": "0.2.2",
  "description": "RMN type checking and structural term analysis over the Relation Model Notation grammar: tyEqual/inferTy/checkTy/hasTy (bidirectional CHL-core typing) and termSize/termUses/isClosed (structural term analysis).",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src/",
    "package.json"
  ],
  "scripts": {
    "check": "node --check src/*.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/relation-model-notation": "0.2.2"
  }
}

{
  "name": "@red-cup-engineering/relation-model-notation-runtime",
  "version": "0.14.0",
  "description": "The Relation Model Notation native runtime: deterministic parsing, typing, normalization, RFC 8949 CBOR, RFC 6920 content addressing, FOUR, WIT, and finite circuit residues.",
  "type": "module",
  "license": "MIT",
  "files": [
    "LICENSE",
    "src/",
    "types/",
    "content/profiles/",
    "content/vectors/",
    "content/",
    "scripts/"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/rmn-core.mjs"
    },
    "./conformance": "./src/conformance.mjs",
    "./circuit-residue": "./src/circuit-residue.mjs",
    "./semantic-content-identity": {
      "types": "./types/semantic-content-identity.d.mts",
      "import": "./src/semantic-content-identity.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@red-cup-engineering/computer-data-engine": "0.11.2",
    "@red-cup-engineering/hierarchical-circuit-law": "0.1.7",
    "@red-cup-engineering/relation-model-notation": "0.2.2",
    "@red-cup-engineering/relation-model-notation-cbor-codec": "0.1.2",
    "@red-cup-engineering/relation-model-notation-eval": "0.2.2",
    "@red-cup-engineering/relation-model-notation-json-codec": "0.2.6",
    "@red-cup-engineering/relation-model-notation-typing": "0.2.2",
    "@red-cup-engineering/relational-value-graph-service": "0.1.4"
  },
  "bin": {
    "semantic-content-identity": "./scripts/semantic-content-identity.mjs"
  }
}

{
  "name": "@red-cup-engineering/relation-model-notation",
  "version": "0.2.2",
  "description": "The Relation Model Notation term and type grammar itself: frozen-array JSON s-expressions, admission schemas, and the structural de-Bruijn operations. No evaluation, no carrier bridge, no pre-built programs.",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./schema": {
      "types": "./src/schema.d.mts",
      "import": "./src/schema.mjs"
    },
    "./validator": {
      "types": "./src/validator.d.mts",
      "import": "./src/validator.mjs"
    },
    "./types": {
      "types": "./src/types.d.mts",
      "import": "./src/types.mjs"
    }
  },
  "files": [
    "src/",
    "package.json"
  ],
  "scripts": {
    "check": "node --check src/*.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@red-cup-engineering/computer-data-engine": "0.11.2"
  }
}

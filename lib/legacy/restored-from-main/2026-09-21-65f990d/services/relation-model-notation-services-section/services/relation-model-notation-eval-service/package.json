{
  "name": "@red-cup-engineering/relation-model-notation-eval",
  "version": "0.2.2",
  "description": "The Relation Model Notation reduction engine: step (one-step reducts), dev (Takahashi complete development), normalize/evaluate (reduction to normal form), and evaluateRunTerm (apply a run-term to admitted JSON, evaluate, decode back to JSON) over the RMN term grammar.",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src/",
    "package.json"
  ],
  "scripts": {
    "check": "node --check src/*.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/relation-model-notation": "0.2.2",
    "@red-cup-engineering/relation-model-notation-typing": "0.2.2",
    "@red-cup-engineering/relation-model-notation-json-codec": "0.2.6"
  }
}

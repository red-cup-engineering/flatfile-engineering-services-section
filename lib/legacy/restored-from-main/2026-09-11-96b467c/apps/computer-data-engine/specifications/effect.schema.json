{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/computer/effect.schema.json",
  "title": "Effect",
  "description": "A declared external-state transition. Every effect names the actor, capability, resource, input claim, and required receipt/refusal condition.",
  "type": "object",
  "required": ["id", "actor", "capability", "resource", "kind", "receiverCondition"],
  "additionalProperties": false,
  "properties": {"id": {"type": "string", "minLength": 1}, "actor": {"$ref": "actor.schema.json"}, "capability": {"$ref": "capability.schema.json"}, "resource": {"$ref": "resource.schema.json"}, "kind": {"type": "string", "minLength": 1}, "receiverCondition": {"type": "string", "minLength": 1}}
}

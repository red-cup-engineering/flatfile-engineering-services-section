{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/computer/event.schema.json",
  "title": "Event",
  "description": "A causally situated attempted operation in a concurrent game system. Its outcome is a receipt or a refusal, never an untyped status string.",
  "type": "object",
  "required": ["id", "actor", "operation", "causes", "outcome"],
  "additionalProperties": false,
  "properties": {"id": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"}, "actor": {"$ref": "actor.schema.json"}, "operation": {"$ref": "operation.schema.json"}, "causes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"}}, "outcome": {"oneOf": [{"$ref": "receipt.schema.json"}, {"$ref": "refusal.schema.json"}]}}
}

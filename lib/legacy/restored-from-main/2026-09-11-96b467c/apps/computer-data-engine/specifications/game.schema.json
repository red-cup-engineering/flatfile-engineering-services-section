{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/computer/game.schema.json",
  "title": "Concurrent Game System",
  "description": "The computer's system model: Actors have strategies over a causally ordered event structure and use shared Resources through declared capabilities. Disagreement remains explicit in the field rather than being overwritten by process order.",
  "type": "object",
  "required": ["id", "actors", "resources", "events", "strategies", "field"],
  "additionalProperties": false,
  "properties": {"id": {"type": "string", "minLength": 1}, "actors": {"type": "array", "minItems": 1, "items": {"$ref": "actor.schema.json"}}, "resources": {"type": "array", "items": {"$ref": "resource.schema.json"}}, "events": {"type": "array", "items": {"$ref": "event.schema.json"}}, "strategies": {"type": "array", "items": {"$ref": "strategy.schema.json"}}, "field": {"$ref": "relational-field.schema.json"}}
}

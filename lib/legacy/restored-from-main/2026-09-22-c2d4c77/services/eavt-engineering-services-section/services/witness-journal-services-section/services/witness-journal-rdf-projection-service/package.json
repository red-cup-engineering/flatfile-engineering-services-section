{
  "name": "@lenticule-science/witness-journal-rdf-projection-service",
  "version": "0.6.0",
  "type": "module",
  "description": "Projects strict SEAVT source rows into RDFC-1.0 named graphs and returns the derived graph bytes' opaque NI commitment. It does not own journal custody, trace, charge, or settlement.",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/witness-journal-rdf.mjs"
    },
    "./http-handler": {
      "types": "./types/http-handler.d.mts",
      "import": "./src/http-handler.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "types"
  ],
  "bin": {
    "project-seavt-rdf": "scripts/project-seavt-rdf.mjs",
    "verify-seavt-rdf-projection": "scripts/verify-seavt-rdf-projection.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/computer-data-engine": "0.10.0",
    "@red-cup-engineering/javascript-file-main-guard-service": "0.1.3",
    "@red-cup-engineering/relation-model-notation-typing": "0.2.0",
    "rdf-canonize": "5.0.0",
    "@red-cup-engineering/eavt": "0.10.4"
  }
}

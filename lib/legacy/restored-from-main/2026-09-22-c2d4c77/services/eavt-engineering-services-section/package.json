{
  "name": "@red-cup-engineering/eavt",
  "version": "0.10.4",
  "type": "module",
  "description": "A typed functional EAVT engine: pure row transforms and one NDJSON/filesystem application boundary.",
  "keywords": [
    "eavt",
    "computer-data",
    "561-group",
    "stratification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/bare-cedar-fog.git",
    "directory": "lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-data-engineering-services-section/services/eavt-engineering-services-section"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/eavt.d.mts",
      "import": "./src/eavt.mjs"
    },
    "./cli": "./apps/eavt.mjs",
    "./package.json": "./package.json",
    "./row": {
      "types": "./src/row.d.mts",
      "import": "./src/row.mjs"
    },
    "./state": {
      "types": "./src/state.d.mts",
      "import": "./src/state.mjs"
    },
    "./journal": {
      "types": "./src/journal.d.mts",
      "import": "./src/journal.mjs"
    },
    "./semantic-record": {
      "types": "./src/semantic-record.d.mts",
      "import": "./src/semantic-record.mjs"
    },
    "./settlement": {
      "types": "./src/settlement.d.mts",
      "import": "./src/settlement.mjs"
    }
  },
  "files": [
    "apps",
    "data",
    "content",
    "README.md",
    "src"
  ],
  "bin": {
    "witness-journal": "apps/witness-journal.mjs"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --experimental-strip-types --test apps/*.test.ts test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@red-cup-engineering/computer-data-engine": "0.11.2",
    "@red-cup-engineering/relation-model-notation-json-codec": "0.2.6",
    "@red-cup-engineering/relation-model-notation-typing": "0.2.2",
    "@red-cup-engineering/relation-model-notation-runtime": "0.14.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
